{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "root": false,
  "extends": "//",
  "files": {
    "includes": ["**", "!records", "!components/ui", "!.next"]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["components/tryouts/tower.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "useFocusableInteractive": "off"
          }
        }
      }
    }
  ]
}
